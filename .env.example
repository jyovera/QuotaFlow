# QuotaFlow Configuration Example

# HTTP Server Port
PORT=3333

# Directories to scan for projects (separated by comma or semicolon)
# In Docker, this is typically /projects
PROJECTS_DIR=D:/AntigravityProyectos

# Antigravity AppData directory (for reading transcripts and token metrics)
# On Windows: C:/Users/<User>/.gemini/antigravity
# In Docker: /antigravity-data
ANTIGRAVITY_DATA_DIR=C:/Users/Jhonnatan/.gemini/antigravity

# Optional: Cortex API Key for memory integration
# If left blank, Anti_Shel will try to read from ~/.gemini/config/mcp_config.json
CORTEX_API_KEY=

# Optional: Google OAuth Client ID & Secret for automatic token refresh
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

